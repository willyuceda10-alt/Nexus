{
  "name": "nexus-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/api"
  ],
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:web": "vite --port=3000 --host=0.0.0.0",
    "dev:api": "npm run dev --workspace @nexus/api",
    "build": "npm run build:web && npm run build:api",
    "build:web": "vite build",
    "build:api": "npm run build --workspace @nexus/api",
    "preview": "vite preview",
    "clean": "rm -rf dist apps/api/dist coverage",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @nexus/api",
    "lint": "npm run typecheck",
    "test": "npm run test --workspace @nexus/api",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed:dev": "tsx prisma/seed.ts && tsx prisma/seed-resource-capacity.ts && tsx prisma/seed-materials.ts"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "prisma": "6.12.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
