{
  "name": "@nexus/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:outbox": "tsx src/outbox-worker.ts",
    "dev:automation": "tsx src/automation-worker.ts",
    "dev:notifications": "tsx src/notification-worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:outbox": "node dist/outbox-worker.js",
    "start:automation": "node dist/automation-worker.js",
    "start:notifications": "node dist/notification-worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/identity": "^4.0.0",
    "@azure/storage-blob": "^12.0.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@prisma/client": "6.12.0",
    "fastify": "^5.4.0",
    "jose": "^6.0.12",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^3.2.4"
  }
}
