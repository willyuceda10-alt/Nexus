// NEXUS OS ENTERPRISE CORE SCHEMA
// PostgreSQL 16 + Multi-Tenant RLS + Universal Object Graph + Transactional Outbox

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// 1. TENANTS, GLOBAL USERS & MEMBERSHIPS
// -----------------------------------------------------------------------------

model Tenant {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String       @db.VarChar(255)
  slug        String       @unique @db.VarChar(100)
  plan        PlanType     @default(ENTERPRISE)
  status      TenantStatus @default(ACTIVE)
  metadata    Json?        @db.JsonB
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships              TenantMembership[]
  workspaces                Workspace[]
  workspaceMemberships      WorkspaceMember[]
  objectDefinitions         ObjectDefinition[]
  nexusObjects              NexusObject[]
  objectFieldValues         ObjectFieldValue[]
  objectRelations           ObjectRelation[]
  objectHistory             ObjectHistory[]
  objectComments            ObjectComment[]
  objectAttachments         ObjectAttachment[]
  workflowDefs              WorkflowDefinition[]
  integrationConnections        IntegrationConnection[]
  integrationSources            IntegrationSource[]
  integrationImportBatches      IntegrationImportBatch[]
  integrationImportRecords      IntegrationImportRecord[]
  integrationImportIssues       IntegrationImportIssue[]
  integrationEntityLinks        IntegrationEntityLink[]
  integrationReconciliationLinks IntegrationReconciliationLink[]
  integrationServicePrincipals  IntegrationServicePrincipal[]
  domainEvents              DomainEvent[]
  auditLogs                 AuditLog[]
  workCalendars             WorkCalendar[]
  workCalendarExceptions    WorkCalendarException[]
  projectScheduleProfiles   ProjectScheduleProfile[]
  workItemSchedules         WorkItemSchedule[]
  scheduleDependenciesV2    ScheduleDependencyV2[]
  projectBaselines          ProjectBaseline[]
  projectBaselineItems      ProjectBaselineItem[]

  @@map("tenants")
}

enum PlanType {
  STARTER
  PROFESSIONAL
  ENTERPRISE
  CUSTOM
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PROVISIONING
  DELETED
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Uniqueness is enforced in the database by the case-insensitive functional index
  // users_email_lower_key (migration 20260905220000_users_email_unique). Prisma cannot
  // model a functional index, so it is intentionally absent from this schema.
  email           String    @db.VarChar(255)
  fullName        String    @map("full_name") @db.VarChar(255)
  avatarUrl       String?   @map("avatar_url") @db.Text
  isActive        Boolean   @default(true) @map("is_active")
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  identities               UserIdentity[]
  tenantMemberships        TenantMembership[]
  workspaceMemberships     WorkspaceMember[]
  ownedObjects             NexusObject[]     @relation("OwnedObjects")
  assignedObjects          NexusObject[]     @relation("AssignedObjects")
  capturedProjectBaselines              ProjectBaseline[] @relation("CapturedProjectBaselines")
  confirmedIntegrationReconciliations IntegrationReconciliationLink[] @relation("IntegrationReconciliationConfirmedBy")

  @@index([email])
  @@map("users")
}

model UserIdentity {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  provider         IdentityProvider
  issuer           String           @db.VarChar(500)
  subject          String           @db.VarChar(255)
  providerTenantId String?          @map("provider_tenant_id") @db.VarChar(255)
  emailSnapshot    String?          @map("email_snapshot") @db.VarChar(255)
  lastSeenAt       DateTime?        @map("last_seen_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, issuer, subject])
  @@index([userId])
  @@index([providerTenantId])
  @@map("user_identities")
}

enum IdentityProvider {
  ENTRA_ID
  LOCAL
  GOOGLE
  GITHUB
}

model TenantMembership {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      TenantRole       @default(MEMBER)
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships")
}

enum TenantRole {
  OWNER
  TENANT_ADMIN
  MEMBER
  GUEST
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model Workspace {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(255)
  code        String   @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships   WorkspaceMember[]
  nexusObjects  NexusObject[]
  workCalendars WorkCalendar[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([tenantId, userId])
  @@map("workspace_members")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

// -----------------------------------------------------------------------------
// 2. DYNAMIC OBJECT DEFINITIONS
// -----------------------------------------------------------------------------

model ObjectDefinition {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  key         String   @db.VarChar(100)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  icon        String?  @db.VarChar(100)
  schema      Json     @db.JsonB
  permissions Json?    @db.JsonB
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nexusObjects NexusObject[]
  workflows    WorkflowDefinition[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("object_definitions")
}

// -----------------------------------------------------------------------------
// 3. UNIVERSAL OBJECT GRAPH
// -----------------------------------------------------------------------------

model NexusObject {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  workspaceId        String    @map("workspace_id") @db.Uuid
  objectDefinitionId String    @map("object_definition_id") @db.Uuid
  objectTypeKey      String    @map("object_type_key") @db.VarChar(100)
  title              String    @db.VarChar(500)
  description        String?   @db.Text
  status             String    @default("DRAFT") @db.VarChar(100)
  priority           String    @default("MEDIUM") @db.VarChar(50)
  progress           Int       @default(0)
  ownerId            String    @map("owner_id") @db.Uuid
  assigneeId         String?   @map("assignee_id") @db.Uuid
  startDate          DateTime? @map("start_date") @db.Timestamptz(6)
  dueDate            DateTime? @map("due_date") @db.Timestamptz(6)
  metadata           Json?     @db.JsonB
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant                   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace                Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  objectDefinition         ObjectDefinition       @relation(fields: [objectDefinitionId], references: [id])
  owner                    User                   @relation("OwnedObjects", fields: [ownerId], references: [id])
  assignee                 User?                  @relation("AssignedObjects", fields: [assigneeId], references: [id])
  fieldValues              ObjectFieldValue[]
  sourceRelations          ObjectRelation[]       @relation("SourceRelations")
  targetRelations          ObjectRelation[]       @relation("TargetRelations")
  history                  ObjectHistory[]
  comments                 ObjectComment[]
  attachments              ObjectAttachment[]
  projectScheduleProfile   ProjectScheduleProfile? @relation("ProjectScheduleProfileProject")
  workItemSchedule         WorkItemSchedule?       @relation("WorkItemScheduleObject")
  projectWorkItemSchedules WorkItemSchedule[]      @relation("WorkItemScheduleProject")
  childWorkItemSchedules   WorkItemSchedule[]      @relation("WorkItemScheduleParent")
  projectDependenciesV2    ScheduleDependencyV2[]  @relation("ScheduleDependencyProject")
  predecessorDependenciesV2 ScheduleDependencyV2[] @relation("ScheduleDependencyPredecessor")
  successorDependenciesV2  ScheduleDependencyV2[]  @relation("ScheduleDependencySuccessor")
  projectBaselines         ProjectBaseline[]       @relation("ProjectBaselineProject")
  baselineItems            ProjectBaselineItem[]   @relation("ProjectBaselineItemWorkItem")

  @@index([tenantId, workspaceId])
  @@index([tenantId, objectTypeKey])
  @@index([tenantId, status])
  @@index([tenantId, ownerId])
  @@index([tenantId, assigneeId])
  @@index([tenantId, updatedAt])
  @@map("nexus_objects")
}

model ObjectFieldValue {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  objectId     String    @map("object_id") @db.Uuid
  fieldKey     String    @map("field_key") @db.VarChar(100)
  valueText    String?   @map("value_text") @db.Text
  valueNumber  Decimal?  @map("value_number") @db.Decimal(18, 4)
  valueDate    DateTime? @map("value_date") @db.Timestamptz(6)
  valueBoolean Boolean?  @map("value_boolean")
  valueJson    Json?     @map("value_json") @db.JsonB
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  object NexusObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([objectId, fieldKey])
  @@index([tenantId, fieldKey, valueNumber])
  @@index([tenantId, fieldKey, valueDate])
  @@map("object_field_values")
}

model ObjectRelation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  sourceObjectId String   @map("source_object_id") @db.Uuid
  targetObjectId String   @map("target_object_id") @db.Uuid
  relationType   String   @map("relation_type") @db.VarChar(100)
  notes          String?  @db.Text
  metadata       Json?    @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant                    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceObject              NexusObject            @relation("SourceRelations", fields: [sourceObjectId], references: [id], onDelete: Cascade)
  targetObject              NexusObject            @relation("TargetRelations", fields: [targetObjectId], references: [id], onDelete: Cascade)
  scheduleDependencyV2      ScheduleDependencyV2?  @relation("ScheduleDependencyLegacyRelation")

  @@unique([sourceObjectId, targetObjectId, relationType])
  @@index([tenantId, sourceObjectId])
  @@index([tenantId, targetObjectId])
  @@map("object_relations")
}

// -----------------------------------------------------------------------------
// 4. PROJECT ENGINE V2 - TYPED SCHEDULING, WBS & IMMUTABLE BASELINES
// -----------------------------------------------------------------------------

enum SchedulingModeV2 {
  AUTO
  MANUAL
}

enum ScheduleConstraintTypeV2 {
  AS_SOON_AS_POSSIBLE
  AS_LATE_AS_POSSIBLE
  MUST_START_ON
  MUST_FINISH_ON
  START_NO_EARLIER_THAN
  START_NO_LATER_THAN
  FINISH_NO_EARLIER_THAN
  FINISH_NO_LATER_THAN
}

enum ScheduleProgressMethodV2 {
  DURATION
  PHYSICAL
}

enum ScheduleDependencyTypeV2 {
  FS
  SS
  FF
  SF
}

model WorkCalendar {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  name            String   @db.VarChar(255)
  timezone        String   @default("UTC") @db.VarChar(100)
  workingWeekdays Int[]    @default([1, 2, 3, 4, 5]) @map("working_weekdays")
  minutesPerDay   Int      @default(480) @map("minutes_per_day")
  isDefault       Boolean  @default(false) @map("is_default")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace        Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  exceptions       WorkCalendarException[]
  scheduleProfiles ProjectScheduleProfile[]

  @@unique([tenantId, workspaceId, name])
  @@index([tenantId, workspaceId])
  @@map("work_calendars")
}

model WorkCalendarException {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  calendarId     String    @map("calendar_id") @db.Uuid
  exceptionDate  DateTime  @map("exception_date") @db.Date
  name           String?   @db.VarChar(255)
  isWorking      Boolean   @default(false) @map("is_working")
  workingMinutes Int?      @map("working_minutes")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calendar WorkCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, exceptionDate])
  @@index([tenantId, exceptionDate])
  @@map("work_calendar_exceptions")
}

model ProjectScheduleProfile {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                   @map("tenant_id") @db.Uuid
  projectObjectId String                   @unique @map("project_object_id") @db.Uuid
  calendarId      String?                  @map("calendar_id") @db.Uuid
  schedulingMode  SchedulingModeV2         @default(AUTO) @map("scheduling_mode")
  progressMethod  ScheduleProgressMethodV2 @default(DURATION) @map("progress_method")
  timezone        String                   @default("UTC") @db.VarChar(100)
  minutesPerDay   Int                      @default(480) @map("minutes_per_day")
  minutesPerWeek  Int                      @default(2400) @map("minutes_per_week")
  statusDate      DateTime?                @map("status_date") @db.Timestamptz(6)
  plannedStart    DateTime?                @map("planned_start") @db.Timestamptz(6)
  targetFinish    DateTime?                @map("target_finish") @db.Timestamptz(6)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project NexusObject   @relation("ProjectScheduleProfileProject", fields: [projectObjectId], references: [id], onDelete: Cascade)
  calendar WorkCalendar? @relation(fields: [calendarId], references: [id], onDelete: SetNull)

  @@index([tenantId, projectObjectId])
  @@map("project_schedule_profiles")
}

model WorkItemSchedule {
  id                        String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                  String                   @map("tenant_id") @db.Uuid
  projectObjectId           String                   @map("project_object_id") @db.Uuid
  objectId                  String                   @unique @map("object_id") @db.Uuid
  parentWorkItemId          String?                  @map("parent_work_item_id") @db.Uuid
  wbsCode                   String?                  @map("wbs_code") @db.VarChar(100)
  outlineLevel              Int                      @default(0) @map("outline_level")
  sortOrder                 Int                      @default(0) @map("sort_order")
  schedulingMode            SchedulingModeV2         @default(AUTO) @map("scheduling_mode")
  durationMinutes           Int                      @default(0) @map("duration_minutes")
  remainingDurationMinutes  Int                      @default(0) @map("remaining_duration_minutes")
  constraintType            ScheduleConstraintTypeV2 @default(AS_SOON_AS_POSSIBLE) @map("constraint_type")
  constraintDate            DateTime?                @map("constraint_date") @db.Timestamptz(6)
  actualStart               DateTime?                @map("actual_start") @db.Timestamptz(6)
  actualFinish              DateTime?                @map("actual_finish") @db.Timestamptz(6)
  physicalPercentComplete   Decimal?                 @map("physical_percent_complete") @db.Decimal(5, 2)
  createdAt                 DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project    NexusObject  @relation("WorkItemScheduleProject", fields: [projectObjectId], references: [id], onDelete: Cascade)
  object     NexusObject  @relation("WorkItemScheduleObject", fields: [objectId], references: [id], onDelete: Cascade)
  parent     NexusObject? @relation("WorkItemScheduleParent", fields: [parentWorkItemId], references: [id], onDelete: SetNull)

  @@index([tenantId, projectObjectId, sortOrder])
  @@index([tenantId, parentWorkItemId])
  @@map("work_item_schedules")
}

model ScheduleDependencyV2 {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String                   @map("tenant_id") @db.Uuid
  projectObjectId     String                   @map("project_object_id") @db.Uuid
  predecessorObjectId String                   @map("predecessor_object_id") @db.Uuid
  successorObjectId   String                   @map("successor_object_id") @db.Uuid
  dependencyType      ScheduleDependencyTypeV2 @default(FS) @map("dependency_type")
  lagMinutes          Int                      @default(0) @map("lag_minutes")
  notes               String?                  @db.Text
  legacyRelationId    String?                  @unique @map("legacy_relation_id") @db.Uuid
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project        NexusObject     @relation("ScheduleDependencyProject", fields: [projectObjectId], references: [id], onDelete: Cascade)
  predecessor    NexusObject     @relation("ScheduleDependencyPredecessor", fields: [predecessorObjectId], references: [id], onDelete: Cascade)
  successor      NexusObject     @relation("ScheduleDependencySuccessor", fields: [successorObjectId], references: [id], onDelete: Cascade)
  legacyRelation ObjectRelation? @relation("ScheduleDependencyLegacyRelation", fields: [legacyRelationId], references: [id], onDelete: SetNull)

  @@unique([projectObjectId, predecessorObjectId, successorObjectId])
  @@index([tenantId, projectObjectId])
  @@map("schedule_dependencies_v2")
}

model ProjectBaseline {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  projectObjectId  String   @map("project_object_id") @db.Uuid
  version          Int
  name             String?  @db.VarChar(255)
  capturedByUserId String?  @map("captured_by_user_id") @db.Uuid
  capturedAt       DateTime @default(now()) @map("captured_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project    NexusObject           @relation("ProjectBaselineProject", fields: [projectObjectId], references: [id], onDelete: Cascade)
  capturedBy User?                 @relation("CapturedProjectBaselines", fields: [capturedByUserId], references: [id], onDelete: SetNull)
  items      ProjectBaselineItem[]

  @@unique([projectObjectId, version])
  @@index([tenantId, projectObjectId, capturedAt])
  @@map("project_baselines")
}

model ProjectBaselineItem {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                 String    @map("tenant_id") @db.Uuid
  baselineId               String    @map("baseline_id") @db.Uuid
  workItemObjectId         String    @map("work_item_object_id") @db.Uuid
  wbsCode                  String?   @map("wbs_code") @db.VarChar(100)
  plannedStart             DateTime? @map("planned_start") @db.Timestamptz(6)
  plannedFinish            DateTime? @map("planned_finish") @db.Timestamptz(6)
  durationMinutes          Int       @default(0) @map("duration_minutes")
  remainingDurationMinutes Int       @default(0) @map("remaining_duration_minutes")
  progress                 Int       @default(0)
  physicalPercentComplete  Decimal?  @map("physical_percent_complete") @db.Decimal(5, 2)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  baseline ProjectBaseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  workItem NexusObject     @relation("ProjectBaselineItemWorkItem", fields: [workItemObjectId], references: [id], onDelete: Cascade)

  @@unique([baselineId, workItemObjectId])
  @@index([tenantId, baselineId])
  @@map("project_baseline_items")
}

model ObjectApprovalRequestV1 {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  objectId             String    @map("object_id") @db.Uuid
  requestedByUserId    String    @map("requested_by_user_id") @db.Uuid
  approverUserId       String    @map("approver_user_id") @db.Uuid
  title                String    @db.VarChar(500)
  description          String?   @db.Text
  previousObjectStatus String    @map("previous_object_status") @db.VarChar(100)
  status               String    @default("PENDING") @db.VarChar(32)
  decisionByUserId     String?   @map("decision_by_user_id") @db.Uuid
  decisionComment      String?   @map("decision_comment") @db.Text
  decidedAt            DateTime? @map("decided_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, objectId, createdAt])
  @@index([tenantId, approverUserId, status, createdAt])
  @@map("object_approval_requests_v1")
}

// -----------------------------------------------------------------------------
// 5. WORKFLOW ENGINE
// -----------------------------------------------------------------------------

model WorkflowDefinition {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  objectDefinitionId String   @map("object_definition_id") @db.Uuid
  name               String   @db.VarChar(255)
  states             Json     @db.JsonB
  transitions        Json     @db.JsonB
  isDefault          Boolean  @default(true) @map("is_default")
  version            Int      @default(1)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  objectDefinition ObjectDefinition @relation(fields: [objectDefinitionId], references: [id], onDelete: Cascade)

  @@index([tenantId, objectDefinitionId])
  @@map("workflow_definitions")
}

// -----------------------------------------------------------------------------
// 6. AUDIT, COLLABORATION & FILE METADATA
// -----------------------------------------------------------------------------

model ObjectHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  objectId  String   @map("object_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  fieldKey  String   @map("field_key") @db.VarChar(100)
  oldValue  Json?    @map("old_value") @db.JsonB
  newValue  Json?    @map("new_value") @db.JsonB
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  object NexusObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([tenantId, objectId, createdAt])
  @@map("object_history")
}

model ObjectComment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  objectId  String   @map("object_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  content   String   @db.Text
  metadata  Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  object NexusObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([tenantId, objectId, createdAt])
  @@map("object_comments")
}

model ObjectAttachment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  objectId       String   @map("object_id") @db.Uuid
  fileName       String   @map("file_name") @db.VarChar(255)
  storageKey     String   @map("storage_key") @db.Text
  fileSize       BigInt   @map("file_size")
  mimeType       String   @map("mime_type") @db.VarChar(150)
  checksumSha256      String?  @map("checksum_sha256") @db.VarChar(64)
  versionNumber       Int      @default(1) @map("version_number")
  uploadedByUserId    String?  @map("uploaded_by_user_id") @db.Uuid
  previousAttachmentId String? @map("previous_attachment_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  object NexusObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([tenantId, objectId])
  @@map("object_attachments")
}

// -----------------------------------------------------------------------------
// 7. EXTERNAL INTEGRATIONS (secrets stay in Azure Key Vault)
// -----------------------------------------------------------------------------

model IntegrationConnection {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String            @map("tenant_id") @db.Uuid
  provider            IntegrationProvider
  status              IntegrationStatus @default(PENDING)
  displayName         String?           @map("display_name") @db.VarChar(255)
  externalTenantId    String?           @map("external_tenant_id") @db.VarChar(255)
  scopes              String[]          @default([])
  credentialReference String?           @map("credential_reference") @db.Text
  config               Json?            @db.JsonB
  lastSyncAt           DateTime?         @map("last_sync_at") @db.Timestamptz(6)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant            Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sources           IntegrationSource[]
  entityLinks       IntegrationEntityLink[]
  reconciliationLinks IntegrationReconciliationLink[]
  servicePrincipals IntegrationServicePrincipal[]

  @@unique([id, tenantId])
  @@index([tenantId, provider, status])
  @@map("integration_connections")
}

model IntegrationSource {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  integrationConnectionId String    @map("integration_connection_id") @db.Uuid
  sourceKey               String    @map("source_key") @db.VarChar(100)
  displayName             String    @map("display_name") @db.VarChar(255)
  schemaVersion           Int       @default(1) @map("schema_version")
  parserVersion           String    @default("1.0.0") @map("parser_version") @db.VarChar(50)
  isActive                Boolean   @default(true) @map("is_active")
  watermark               Json?     @db.JsonB
  config                  Json?     @db.JsonB
  lastSuccessAt           DateTime? @map("last_success_at") @db.Timestamptz(6)
  lastGeneratedAt         DateTime? @map("last_generated_at") @db.Timestamptz(6)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [integrationConnectionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  batches    IntegrationImportBatch[]

  @@unique([tenantId, integrationConnectionId, sourceKey])
  @@unique([id, tenantId])
  @@index([tenantId, integrationConnectionId, isActive])
  @@map("integration_sources")
}

model IntegrationImportBatch {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  integrationSourceId  String    @map("integration_source_id") @db.Uuid
  originalFilename     String    @map("original_filename") @db.VarChar(255)
  contentType          String    @map("content_type") @db.VarChar(150)
  fileSize             BigInt    @map("file_size")
  checksumSha256       String    @map("checksum_sha256") @db.VarChar(64)
  storageKey           String    @map("storage_key") @db.Text
  sourceGeneratedAt    DateTime? @map("source_generated_at") @db.Timestamptz(6)
  receivedAt           DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processingStartedAt  DateTime? @map("processing_started_at") @db.Timestamptz(6)
  processingFinishedAt DateTime? @map("processing_finished_at") @db.Timestamptz(6)
  status               String    @default("RECEIVED") @db.VarChar(30)
  schemaVersion        Int       @map("schema_version")
  parserVersion        String    @map("parser_version") @db.VarChar(50)
  totalRecords         Int       @default(0) @map("total_records")
  acceptedRecords      Int       @default(0) @map("accepted_records")
  insertedRecords      Int       @default(0) @map("inserted_records")
  updatedRecords       Int       @default(0) @map("updated_records")
  unchangedRecords     Int       @default(0) @map("unchanged_records")
  warningRecords       Int       @default(0) @map("warning_records")
  rejectedRecords      Int       @default(0) @map("rejected_records")
  errorSummary         String?   @map("error_summary") @db.Text
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source  IntegrationSource  @relation(fields: [integrationSourceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  records IntegrationImportRecord[]
  issues  IntegrationImportIssue[]

  @@unique([tenantId, integrationSourceId, checksumSha256])
  @@unique([id, tenantId])
  @@index([tenantId, integrationSourceId, receivedAt])
  @@index([tenantId, status, receivedAt])
  @@map("integration_import_batches")
}

model IntegrationImportRecord {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  batchId            String   @map("batch_id") @db.Uuid
  rowNumber          Int      @map("row_number")
  externalKey        String?  @map("external_key") @db.VarChar(255)
  recordHash         String   @map("record_hash") @db.VarChar(64)
  rawPayload         Json     @map("raw_payload") @db.JsonB
  normalizedPayload  Json?    @map("normalized_payload") @db.JsonB
  validationStatus   String   @default("VALID") @map("validation_status") @db.VarChar(20)
  processingStatus   String   @default("PENDING") @map("processing_status") @db.VarChar(20)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant              Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch               IntegrationImportBatch          @relation(fields: [batchId, tenantId], references: [id, tenantId], onDelete: Cascade)
  issues              IntegrationImportIssue[]
  entityLinks         IntegrationEntityLink[]
  leftReconciliations IntegrationReconciliationLink[] @relation("IntegrationReconciliationLeft")
  rightReconciliations IntegrationReconciliationLink[] @relation("IntegrationReconciliationRight")

  @@unique([tenantId, batchId, rowNumber])
  @@unique([id, tenantId])
  @@index([tenantId, externalKey])
  @@index([tenantId, batchId, recordHash])
  @@map("integration_import_records")
}

model IntegrationImportIssue {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  batchId   String   @map("batch_id") @db.Uuid
  recordId  String?  @map("record_id") @db.Uuid
  severity  String   @db.VarChar(20)
  code      String   @db.VarChar(100)
  fieldKey  String?  @map("field_key") @db.VarChar(150)
  message   String   @db.Text
  details   Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch  IntegrationImportBatch   @relation(fields: [batchId, tenantId], references: [id, tenantId], onDelete: Cascade)
  record IntegrationImportRecord? @relation(fields: [recordId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, batchId, severity])
  @@index([tenantId, recordId])
  @@map("integration_import_issues")
}

model IntegrationEntityLink {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  integrationConnectionId String    @map("integration_connection_id") @db.Uuid
  sourceRecordId          String?   @map("source_record_id") @db.Uuid
  externalEntityType      String    @map("external_entity_type") @db.VarChar(100)
  externalKey             String    @map("external_key") @db.VarChar(255)
  canonicalEntityType     String    @map("canonical_entity_type") @db.VarChar(100)
  canonicalEntityId       String    @map("canonical_entity_id") @db.Uuid
  metadata                Json?     @db.JsonB
  firstSeenAt             DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt              DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection   IntegrationConnection    @relation(fields: [integrationConnectionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  sourceRecord IntegrationImportRecord? @relation(fields: [sourceRecordId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([tenantId, integrationConnectionId, externalEntityType, externalKey])
  @@index([tenantId, canonicalEntityType, canonicalEntityId])
  @@map("integration_entity_links")
}

model IntegrationReconciliationLink {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  integrationConnectionId String    @map("integration_connection_id") @db.Uuid
  leftRecordId            String    @map("left_record_id") @db.Uuid
  rightRecordId           String    @map("right_record_id") @db.Uuid
  relationshipType        String    @map("relationship_type") @db.VarChar(100)
  matchMethod             String    @map("match_method") @db.VarChar(100)
  confidence              Decimal   @default(1) @db.Decimal(5, 4)
  status                  String    @default("MATCHED") @db.VarChar(30)
  evidence                Json?     @db.JsonB
  confirmedByUserId       String?   @map("confirmed_by_user_id") @db.Uuid
  confirmedAt             DateTime? @map("confirmed_at") @db.Timestamptz(6)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection   IntegrationConnection @relation(fields: [integrationConnectionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  leftRecord   IntegrationImportRecord @relation("IntegrationReconciliationLeft", fields: [leftRecordId, tenantId], references: [id, tenantId], onDelete: Cascade)
  rightRecord  IntegrationImportRecord @relation("IntegrationReconciliationRight", fields: [rightRecordId, tenantId], references: [id, tenantId], onDelete: Cascade)
  confirmedBy  User?                  @relation("IntegrationReconciliationConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, integrationConnectionId, leftRecordId, rightRecordId, relationshipType])
  @@index([tenantId, leftRecordId, relationshipType])
  @@index([tenantId, rightRecordId, relationshipType])
  @@map("integration_reconciliation_links")
}

model IntegrationServicePrincipal {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  integrationConnectionId String    @map("integration_connection_id") @db.Uuid
  clientId                String    @map("client_id") @db.Uuid
  displayName             String    @map("display_name") @db.VarChar(255)
  allowedSourceKeys       String[]  @default([]) @map("allowed_source_keys")
  status                  String    @default("ACTIVE") @db.VarChar(20)
  lastUsedAt              DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [integrationConnectionId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, clientId])
  @@index([tenantId, integrationConnectionId, status])
  @@map("integration_service_principals")
}

enum IntegrationProvider {
  MICROSOFT_365
  SAP
  GITHUB
  SLACK
  GOOGLE_WORKSPACE
  CUSTOM
}

enum IntegrationStatus {
  PENDING
  ACTIVE
  DEGRADED
  DISCONNECTED
}

// -----------------------------------------------------------------------------
// 8. TRANSACTIONAL OUTBOX & AUDIT LOG
// -----------------------------------------------------------------------------

model DomainEvent {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  aggregateId    String      @map("aggregate_id") @db.Uuid
  eventType      String      @map("event_type") @db.VarChar(150)
  payload        Json        @db.JsonB
  status         EventStatus @default(PENDING)
  attempts       Int         @default(0)
  availableAt    DateTime    @default(now()) @map("available_at") @db.Timestamptz(6)
  lockedAt       DateTime?   @map("locked_at") @db.Timestamptz(6)
  processedAt    DateTime?   @map("processed_at") @db.Timestamptz(6)
  lastError      String?     @map("last_error") @db.Text
  idempotencyKey String?     @unique @map("idempotency_key") @db.VarChar(255)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, availableAt])
  @@map("domain_events")
}

enum EventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  action        String   @db.VarChar(100)
  resource      String   @db.VarChar(100)
  resourceId    String?  @map("resource_id") @db.Uuid
  details       Json?    @db.JsonB
  correlationId String?  @map("correlation_id") @db.VarChar(128)
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, resource, resourceId])
  @@map("audit_logs")
}
