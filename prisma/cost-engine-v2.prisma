// Bridata Project - Cost Engine V2
// Project controlling only. This is not a general ledger.
// Foreign keys, checks and RLS are enforced by SQL migrations.

model ProjectCostProfileV2 {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  projectObjectId String   @unique(map: "project_cost_profiles_project_object_id_key") @map("project_object_id") @db.Uuid
  currency        String   @default("USD") @db.VarChar(3)
  contingencyAmount Decimal @default(0) @map("contingency_amount") @db.Decimal(18, 4)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, workspaceId], map: "project_cost_profiles_workspace_idx")
  @@map("project_cost_profiles")
}

model CostCodeV2 {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  code             String   @db.VarChar(80)
  name             String   @db.VarChar(255)
  category         String   @default("OTHER") @db.VarChar(30)
  parentCostCodeId String?  @map("parent_cost_code_id") @db.Uuid
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, workspaceId, code], map: "cost_codes_workspace_code_key")
  @@index([tenantId, workspaceId, category], map: "cost_codes_workspace_category_idx")
  @@map("cost_codes")
}

model ProjectBudgetLineV2 {
  id                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                   String   @map("tenant_id") @db.Uuid
  workspaceId                String   @map("workspace_id") @db.Uuid
  projectObjectId            String   @map("project_object_id") @db.Uuid
  workItemObjectId           String?  @map("work_item_object_id") @db.Uuid
  costCodeId                 String   @map("cost_code_id") @db.Uuid
  materialId                 String?  @map("material_id") @db.Uuid
  description                String   @db.VarChar(500)
  plannedAmount              Decimal  @default(0) @map("planned_amount") @db.Decimal(18, 4)
  approvedAmount             Decimal  @default(0) @map("approved_amount") @db.Decimal(18, 4)
  forecastRemainingUncommitted Decimal? @map("forecast_remaining_uncommitted") @db.Decimal(18, 4)
  notes                      String?  @db.Text
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, projectObjectId, costCodeId], map: "project_budget_lines_project_cost_code_idx")
  @@index([tenantId, workItemObjectId], map: "project_budget_lines_work_item_idx")
  @@index([tenantId, materialId], map: "project_budget_lines_material_idx")
  @@map("project_budget_lines")
}

