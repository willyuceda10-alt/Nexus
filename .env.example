# -----------------------------------------------------------------------------
# FRONTEND / AI STUDIO (legacy prototype settings)
# -----------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# NEXUS API
# -----------------------------------------------------------------------------
NODE_ENV="development"
HOST="0.0.0.0"
PORT="8080"
LOG_LEVEL="info"
DATABASE_URL="postgresql://nexus:nexus@localhost:5432/nexus"
CORS_ORIGINS="http://localhost:3000"

# Production authentication uses the dedicated Nexus runtime App Registration.
# Do NOT reuse nexus-github-deploy: that identity exists only for CI/CD.
AUTH_MODE="entra"
ENTRA_CLIENT_ID="00000000-0000-0000-0000-000000000000"

# Local-only authentication. Never enable in production.
DEV_AUTH_ENABLED="false"
DEV_USER_ID="00000000-0000-4000-8000-000000000001"
DEV_TENANT_ID="00000000-0000-4000-8000-000000000002"

# Microsoft 365 integration will use a separate App Registration and Key Vault.
# No client secrets should be committed to this file or to the repository.
