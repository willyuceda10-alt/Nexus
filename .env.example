# -----------------------------------------------------------------------------
# BRIDATA PROJECT WEB
# -----------------------------------------------------------------------------
# Keep `mock` while a surface is being migrated. Switch to `api` to validate
# the real backend bootstrap and subsequent API-backed modules.
VITE_DATA_MODE="mock"
VITE_API_BASE_URL="http://localhost:8080"

# -----------------------------------------------------------------------------
# BRIDATA PROJECT API
# -----------------------------------------------------------------------------
NODE_ENV="development"
HOST="0.0.0.0"
PORT="8080"
LOG_LEVEL="info"
DATABASE_URL="postgresql://nexus:nexus@localhost:5432/nexus"
CORS_ORIGINS="http://localhost:3000"

# Local development auth. The API rejects AUTH_MODE=dev when NODE_ENV=production.
AUTH_MODE="dev"
DEV_AUTH_ENABLED="true"
DEV_USER_ID="00000000-0000-4000-8000-000000000001"
DEV_TENANT_ID="00000000-0000-4000-8000-000000000002"

# Production authentication will use a dedicated Bridata Project runtime App
# Registration in Microsoft Entra ID. Do NOT reuse nexus-github-deploy: that
# identity is reserved for GitHub Actions CI/CD.
# AUTH_MODE="entra"
# ENTRA_CLIENT_ID="00000000-0000-0000-0000-000000000000"

# Microsoft 365 integration will use a separate App Registration and Azure Key
# Vault. Never commit client secrets, access tokens or refresh tokens here.
