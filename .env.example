# -----------------------------------------------------------------------------
# BRIDATA PROJECT WEB
# -----------------------------------------------------------------------------
# Keep `mock` while a surface is being migrated. Switch to `api` to validate
# the real backend bootstrap and subsequent API-backed modules.
VITE_DATA_MODE="mock"
VITE_API_BASE_URL="http://localhost:8080"

# Runtime Microsoft Entra SPA settings will be enabled by the web-auth phase.
# The web client and API MUST use separate App Registrations.
# VITE_AUTH_MODE="entra"
# VITE_ENTRA_WEB_CLIENT_ID="00000000-0000-0000-0000-000000000000"
# VITE_ENTRA_TENANT_ID="00000000-0000-0000-0000-000000000000"
# VITE_ENTRA_API_SCOPE="api://00000000-0000-0000-0000-000000000000/access_as_user"

# -----------------------------------------------------------------------------
# BRIDATA PROJECT API
# -----------------------------------------------------------------------------
NODE_ENV="development"
HOST="0.0.0.0"
PORT="8080"
LOG_LEVEL="info"
DATABASE_URL="postgresql://nexus:nexus@localhost:5432/nexus"
CORS_ORIGINS="http://localhost:3000"

# Local development auth. The API rejects AUTH_MODE=dev when NODE_ENV=production.
AUTH_MODE="dev"
DEV_AUTH_ENABLED="true"
DEV_USER_ID="00000000-0000-4000-8000-000000000001"
DEV_TENANT_ID="00000000-0000-4000-8000-000000000002"

# Production/runtime authentication uses the dedicated Bridata Project API App
# Registration. Do NOT reuse either the web SPA client or nexus-github-deploy.
# No client secret is required for validating delegated user access tokens.
# AUTH_MODE="entra"
# ENTRA_API_CLIENT_ID="00000000-0000-0000-0000-000000000000"
# ENTRA_TENANT_ID="00000000-0000-0000-0000-000000000000"
# ENTRA_REQUIRED_SCOPE="access_as_user"

# Governed document binaries. Local/test can use the in-memory adapter only for
# verification. Production API must use Azure Blob with the user-assigned
# managed identity; no Storage account key or connection string is accepted.
DOCUMENT_STORAGE_MODE="memory"
AZURE_DOCUMENT_CONTAINER="bridata-documents"
DOCUMENT_MAX_FILE_BYTES="26214400"
# DOCUMENT_STORAGE_MODE="azure"
# AZURE_STORAGE_ACCOUNT_NAME="nexusdev..."
# AZURE_CLIENT_ID="00000000-0000-0000-0000-000000000000"

# Governed source-system imports. Filenames are retained as evidence only; the
# logical source key identifies business meaning. Production stores originals
# in a private Blob container through the API managed identity.
INTEGRATION_STORAGE_MODE="memory"
AZURE_INTEGRATION_CONTAINER="bridata-imports"
INTEGRATION_MAX_FILE_BYTES="52428800"
# INTEGRATION_STORAGE_MODE="azure"

# Microsoft 365 integration will use a separate App Registration and Azure Key
# Vault. Never commit client secrets, access tokens or refresh tokens here.
